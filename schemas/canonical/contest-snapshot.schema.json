{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tft.coach/schemas/canonical/contest-snapshot.schema.json",
  "title": "ContestSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["unit_id", "contested_level", "source", "confidence"],
  "properties": {
    "unit_id": { "$ref": "https://tft.coach/schemas/canonical/common-defs.schema.json#/$defs/canonicalId" },
    "known_holders": { "type": "integer", "minimum": 0 },
    "contested_level": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": {
      "type": "string",
      "enum": ["OBSERVED", "META", "POST_GAME", "UNKNOWN"]
    },
    "confidence": { "$ref": "https://tft.coach/schemas/canonical/common-defs.schema.json#/$defs/confidence" },
    "captured_at": { "$ref": "https://tft.coach/schemas/canonical/common-defs.schema.json#/$defs/isoDateTime" }
  }
}
