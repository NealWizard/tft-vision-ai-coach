{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tft.coach/schemas/canonical/mechanic.schema.json",
  "title": "Mechanic",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "patch", "name", "kind"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "id": { "$ref": "https://tft.coach/schemas/canonical/common-defs.schema.json#/$defs/canonicalId" },
    "patch": { "$ref": "https://tft.coach/schemas/canonical/common-defs.schema.json#/$defs/patchId" },
    "name": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["encounter", "portal", "constellation", "special_trait", "temporary_rule", "other"]
    },
    "description": { "type": "string" },
    "parameters": { "type": "object" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "https://tft.coach/schemas/canonical/common-defs.schema.json#/$defs/evidenceRef" }
    }
  }
}
