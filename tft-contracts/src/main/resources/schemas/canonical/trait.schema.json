{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tft.coach/schemas/canonical/trait.schema.json",
  "title": "Trait",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "patch", "name", "breakpoints"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "id": { "$ref": "https://tft.coach/schemas/canonical/common-defs.schema.json#/$defs/canonicalId" },
    "patch": { "$ref": "https://tft.coach/schemas/canonical/common-defs.schema.json#/$defs/patchId" },
    "name": { "type": "string", "minLength": 1 },
    "breakpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["units", "style"],
        "properties": {
          "units": { "type": "integer", "minimum": 1 },
          "style": { "type": "string", "enum": ["bronze", "silver", "gold", "prismatic", "unique"] },
          "effect": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "https://tft.coach/schemas/canonical/common-defs.schema.json#/$defs/evidenceRef" }
    }
  }
}
